# Model weights are published as GitHub Release assets, not stored in git
*.pt
*.pth
*.onnx
*.pte
*.engine

# Datasets and bulky training output
data/
datasets/
runs/
**/ip102_yolo/
*.cache

# Kaggle credentials and per-user upload settings
kaggle.json
access_token
**/kernel-metadata.json

# Python and notebook clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Editor and system files
.vscode/
.idea/
.DS_Store

# Generated by app/kb/build_kb.py from app/kb/tomato_kb.json
app/kb/tomato_kb.sqlite

# C++ build output
build/

# Hydra log folders written by the ExecuTorch Llama exporter
outputs/
# Llama tokenizer: published with the .pte as a release asset (Llama 3.2 licence), not stored in git
models/*.model
# IndicTrans2 translation model (CTranslate2 INT8, ~210 MB) and its SentencePiece model: built with
# tools/convert_indictrans2_ct2.py from the public Hugging Face checkpoint, not stored in git
models/indictrans2_*

# Pi deployment bundle (cpp/package_pi.sh)
dist/
*.apk
